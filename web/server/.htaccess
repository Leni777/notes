# Do složky server/ se zvenku dostane jen index.php (env.json, lib/ a schema.sql jsou zakázané).
Options -Indexes
<IfModule mod_authz_core.c>
  Require all denied
  <Files "index.php">
    Require all granted
  </Files>
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
  <Files "index.php">
    Allow from all
  </Files>
</IfModule>
